digraph CurrentGitChangesDependencies {
    graph [
        rankdir=LR,
        bgcolor="white",
        fontname="Helvetica",
        label="Current Git Changes: Route Navigation ADR 0003 Dependency Graph",
        labelloc=t,
        fontsize=20
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=11,
        fillcolor="white",
        color="#6b7280"
    ];

    edge [
        fontname="Helvetica",
        fontsize=10,
        color="#374151",
        arrowsize=0.8
    ];

    subgraph cluster_legend {
        label="Legend";
        color="#e5e7eb";
        style="rounded,dashed";

        LegendOwner [label="owner / lifecycle", fillcolor="#dbeafe"];
        LegendCommit [label="camera commit path", fillcolor="#dcfce7"];
        LegendSnapshot [label="snapshot derivation", fillcolor="#ede9fe"];
        LegendRender [label="render consumption", fillcolor="#ffedd5"];
        LegendLegacy [label="legacy retained / out of scope", fillcolor="#f3f4f6"];
    }

    subgraph cluster_composition {
        label="Composition / Public Surface";
        color="#bfdbfe";
        style="rounded";

        MetalModuleResources [
            label="MetalModuleResources\n(changed wiring)",
            fillcolor="#eff6ff"
        ];
        MetalModuleNavigationControlling [
            label="MetalModuleNavigationControlling\n(public API unchanged)",
            fillcolor="#eff6ff"
        ];
        NavigationRenderStatePublishing [
            label="NavigationRenderStatePublishing\n(publishes UI state)",
            fillcolor="#eff6ff"
        ];
    }

    subgraph cluster_navigation {
        label="Route Navigation Ownership";
        color="#93c5fd";
        style="rounded";

        NavigationController [
            label="NavigationController\n(route nav owner)",
            fillcolor="#dbeafe"
        ];
        NavigationControllerCamera [
            label="NavigationController+Camera\n(route camera orchestration)",
            fillcolor="#dbeafe"
        ];
        NavigationControllerProjection [
            label="NavigationController+Projection\n(nav projection dependency state)",
            fillcolor="#dbeafe"
        ];
        NavigationControllerRoute [
            label="NavigationController+Route\n(public nav commands)",
            fillcolor="#dbeafe"
        ];
        NavigationRouteCoordinator [
            label="NavigationRouteCoordinator\n(route playback state)",
            fillcolor="#dbeafe"
        ];
        NavigationRouteRenderState [
            label="NavigationRouteRenderState\n(route render handoff)",
            fillcolor="#dbeafe"
        ];
        NavigationProjectionState [
            label="NavigationCameraProjectionState\n(snapshot input)",
            fillcolor="#ede9fe"
        ];
    }

    subgraph cluster_camera {
        label="Camera Pipeline";
        color="#86efac";
        style="rounded";

        CameraCoordinator [
            label="CameraCoordinator\n(navigation camera owner)",
            fillcolor="#dcfce7"
        ];
        NavigationCameraMode [
            label="NavigationCameraMode\n(computes transactions)",
            fillcolor="#dcfce7"
        ];
        CameraState [
            label="CameraState\n(canonical camera variables + revision)",
            fillcolor="#dcfce7"
        ];
        CameraTransaction [
            label="CameraState.Transaction\n(atomic camera mutation)",
            fillcolor="#dcfce7"
        ];
        SnapshotProvider [
            label="SnapshotProvider\n(camera snapshot producer)",
            fillcolor="#ede9fe"
        ];
        CameraSnapshot [
            label="SnapshotProvider.CameraSnapshot\n(immutable render camera)",
            fillcolor="#ede9fe"
        ];
        PreparedRenderSnapshotProvider [
            label="PreparedRenderSnapshotProviding\n(scene snapshot source)",
            fillcolor="#ede9fe"
        ];
    }

    subgraph cluster_renderer {
        label="Renderer Consumption";
        color="#fdba74";
        style="rounded";

        MetalRenderer [
            label="MetalRenderer\n(ticks nav, consumes camera snapshot)",
            fillcolor="#ffedd5"
        ];
        DrawFirstPass [
            label="MetalRenderer+DrawFirstPass\n(render encoding)",
            fillcolor="#ffedd5"
        ];
        SceneRenderState [
            label="SceneRenderState\n(camera + scene + routes)",
            fillcolor="#ffedd5"
        ];
        SceneRouteRenderState [
            label="SceneRouteRenderState\n(transfer + navigation routes)",
            fillcolor="#ffedd5"
        ];
        RouteRenderer [
            label="RouteRenderer\n(uses nav route render state)",
            fillcolor="#ffedd5"
        ];
        TransferPreview [
            label="HohmannTransferOrbit preview\n(renderer-owned, out of scope)",
            fillcolor="#f3f4f6"
        ];
        LegacyFollowCamera [
            label="legacy follow / transfer camera\n(renderer-owned, retained)",
            fillcolor="#f3f4f6"
        ];
    }

    subgraph cluster_tests {
        label="Tests";
        color="#d1d5db";
        style="rounded";

        NavigationControllerTests [
            label="NavigationControllerTests\n(updated fixture + transaction test)",
            fillcolor="#f9fafb"
        ];
    }

    MetalModuleResources -> CameraState [
        label="creates",
        color="#2563eb"
    ];
    MetalModuleResources -> CameraCoordinator [
        label="creates with CameraState",
        color="#2563eb"
    ];
    MetalModuleResources -> SnapshotProvider [
        label="creates with CameraState + scene source",
        color="#2563eb"
    ];
    MetalModuleResources -> NavigationController [
        label="creates with CameraCoordinator",
        color="#2563eb"
    ];
    MetalModuleResources -> MetalRenderer [
        label="injects NavigationController",
        color="#2563eb"
    ];
    MetalModuleResources -> NavigationRenderStatePublishing [
        label="implements",
        color="#2563eb"
    ];
    MetalModuleResources -> MetalModuleNavigationControlling [
        label="exposes navigation facade",
        color="#2563eb"
    ];

    NavigationController -> MetalModuleNavigationControlling [
        label="implements",
        color="#2563eb"
    ];
    NavigationController -> NavigationRenderStatePublishing [
        label="publishes snapshots + follow flag",
        color="#2563eb"
    ];
    NavigationController -> NavigationRouteCoordinator [
        label="owns",
        color="#2563eb",
        penwidth=2
    ];
    NavigationController -> SnapshotProvider [
        label="reads latest scene snapshot",
        color="#7c3aed"
    ];
    NavigationController -> CameraCoordinator [
        label="requests nav camera ownership/commits",
        color="#16a34a",
        penwidth=2
    ];
    NavigationController -> NavigationRouteRenderState [
        label="exposes routeRenderState",
        color="#ea580c"
    ];
    NavigationControllerProjection -> NavigationProjectionState [
        label="creates projection dependency input",
        color="#7c3aed",
        penwidth=2
    ];
    NavigationControllerProjection -> CameraCoordinator [
        label="reads camera target/distance",
        color="#16a34a"
    ];
    NavigationControllerCamera -> CameraCoordinator [
        label="commits follow/arrival/overview",
        color="#16a34a",
        penwidth=2
    ];
    NavigationControllerRoute -> NavigationRouteCoordinator [
        label="start/pause/resume/cancel/done",
        color="#2563eb"
    ];

    CameraCoordinator -> NavigationCameraMode [
        label="owns mode math",
        color="#16a34a",
        penwidth=2
    ];
    NavigationCameraMode -> CameraTransaction [
        label="returns transactions",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> CameraState [
        label="commits transactions",
        color="#16a34a",
        penwidth=2
    ];
    CameraTransaction -> CameraState [
        label="target/position/offset/up/distance/orientation",
        color="#16a34a"
    ];
    CameraState -> SnapshotProvider [
        label="canonical camera variables + revision",
        color="#7c3aed"
    ];
    PreparedRenderSnapshotProvider -> SnapshotProvider [
        label="latest scene snapshot",
        color="#7c3aed"
    ];
    NavigationProjectionState -> SnapshotProvider [
        label="nav near/far dependencies",
        color="#7c3aed",
        penwidth=2
    ];
    SnapshotProvider -> CameraSnapshot [
        label="produces immutable render camera",
        color="#7c3aed",
        penwidth=2
    ];

    MetalRenderer -> NavigationController [
        label="ticks route navigation; reads controlsCamera",
        color="#ea580c"
    ];
    MetalRenderer -> SnapshotProvider [
        label="requests CameraSnapshot",
        color="#7c3aed",
        penwidth=2
    ];
    MetalRenderer -> SceneRenderState [
        label="assembles render state",
        color="#ea580c"
    ];
    SceneRenderState -> CameraSnapshot [
        label="contains",
        color="#ea580c"
    ];
    SceneRenderState -> SceneRouteRenderState [
        label="contains",
        color="#ea580c"
    ];
    SceneRouteRenderState -> NavigationRouteRenderState [
        label="contains",
        color="#ea580c"
    ];
    SceneRouteRenderState -> TransferPreview [
        label="contains",
        color="#9ca3af",
        style=dashed
    ];
    MetalRenderer -> DrawFirstPass [
        label="passes SceneRenderState",
        color="#ea580c"
    ];
    DrawFirstPass -> CameraSnapshot [
        label="uses matrices/origin/viewport",
        color="#ea580c",
        penwidth=2
    ];
    DrawFirstPass -> RouteRenderer [
        label="passes nav route state",
        color="#ea580c"
    ];

    MetalRenderer -> LegacyFollowCamera [
        label="retained non-navigation camera behavior",
        color="#9ca3af",
        style=dashed
    ];
    MetalRenderer -> TransferPreview [
        label="retained renderer ownership",
        color="#9ca3af",
        style=dashed
    ];
    LegacyFollowCamera -> CameraState [
        label="legacy setters still used",
        color="#9ca3af",
        style=dashed
    ];
    TransferPreview -> CameraState [
        label="legacy transition state still used",
        color="#9ca3af",
        style=dashed
    ];

    NavigationControllerTests -> NavigationController [
        label="exercises route lifecycle",
        color="#4b5563"
    ];
    NavigationControllerTests -> CameraCoordinator [
        label="asserts nav camera ownership",
        color="#4b5563"
    ];
    NavigationControllerTests -> CameraState [
        label="asserts single revision commit",
        color="#4b5563"
    ];
}
