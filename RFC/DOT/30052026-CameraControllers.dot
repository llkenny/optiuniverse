digraph CurrentGitChangesDependencies {
    graph [
        rankdir=LR,
        bgcolor="white",
        fontname="Helvetica",
        label="Current Git Changes: Route Navigation ADR 0003 Dependency Graph",
        labelloc=t,
        fontsize=20
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=11,
        fillcolor="white",
        color="#6b7280"
    ];

    edge [
        fontname="Helvetica",
        fontsize=10,
        color="#374151",
        arrowsize=0.8
    ];

    subgraph cluster_legend {
        label="Legend";
        color="#e5e7eb";
        style="rounded,dashed";

        LegendOwner [label="owner / lifecycle", fillcolor="#dbeafe"];
        LegendFacade [label="observable public facade", fillcolor="#fef3c7"];
        LegendCommit [label="camera commit path", fillcolor="#dcfce7"];
        LegendSnapshot [label="snapshot derivation", fillcolor="#ede9fe"];
        LegendRender [label="render consumption", fillcolor="#ffedd5"];
        LegendMode [label="current camera mode", fillcolor="#dcfce7"];
    }

    subgraph cluster_composition {
        label="Composition / Public Surface";
        color="#fde68a";
        style="rounded";

        MetalModuleResources [
            label="MetalModuleResources\n@Observable public facade\nmirrors nav snapshot + follow flag",
            fillcolor="#fef3c7"
        ];
        MetalModuleNavigationControlling [
            label="MetalModuleNavigationControlling\n(public API unchanged)",
            fillcolor="#fef3c7"
        ];
        MetalModuleTransferOrbitControlling [
            label="MetalModuleTransferOrbitControlling\nshow/clear preview facade",
            fillcolor="#fef3c7"
        ];
        NavigationStateCallbacks [
            label="NavigationController callbacks\nsnapshotDidChange / followDidChange",
            fillcolor="#fef3c7"
        ];
    }

    subgraph cluster_navigation {
        label="Route Navigation Ownership";
        color="#93c5fd";
        style="rounded";

        NavigationController [
            label="NavigationController\n(route navigation owner)",
            fillcolor="#dbeafe"
        ];
        NavigationControllerCamera [
            label="NavigationController+Camera\nroute camera orchestration",
            fillcolor="#dbeafe"
        ];
        NavigationControllerProjection [
            label="NavigationController+Projection\nroute projection policy",
            fillcolor="#dbeafe"
        ];
        NavigationControllerRoute [
            label="NavigationController+Route\nroute lifecycle commands",
            fillcolor="#dbeafe"
        ];
        NavigationRouteCoordinator [
            label="NavigationRouteCoordinator\nroute playback state",
            fillcolor="#dbeafe"
        ];
        NavigationRouteRenderState [
            label="NavigationRouteRenderState\nroute render handoff",
            fillcolor="#dbeafe"
        ];
        CameraProjectionParameters [
            label="CameraProjectionParameters\ngeneric near/far input",
            fillcolor="#ede9fe"
        ];
    }

    subgraph cluster_transfer_preview {
        label="Transfer Preview Ownership";
        color="#c4b5fd";
        style="rounded";

        TransferOrbitController [
            label="TransferOrbitController\npreview lifecycle owner",
            fillcolor="#ede9fe"
        ];
    }

    subgraph cluster_camera {
        label="Camera Pipeline";
        color="#86efac";
        style="rounded";

        CameraCoordinator [
            label="CameraCoordinator\nroutes camera ownership\ncommits manual transactions",
            fillcolor="#dcfce7"
        ];
        NavigationCameraCoordinating [
            label="NavigationCameraCoordinating\nnarrow nav camera protocol",
            fillcolor="#dcfce7"
        ];
        TransferPreviewCameraCoordinating [
            label="TransferPreviewCameraCoordinating\nnarrow preview camera protocol",
            fillcolor="#dcfce7"
        ];
        NavigationCameraOwner [
            label="NavigationCameraOwner\nowns route camera priority",
            fillcolor="#dcfce7"
        ];
        TransferPreviewCameraOwner [
            label="TransferPreviewCameraOwner\ncommits preview transactions",
            fillcolor="#dcfce7"
        ];
        FollowCameraOwner [
            label="FollowCameraOwner\nowns current follow lifecycle",
            fillcolor="#dcfce7"
        ];
        FollowCameraMode [
            label="FollowCameraMode\ncomputes follow transactions",
            fillcolor="#dcfce7"
        ];
        OrbitCameraMode [
            label="OrbitCameraMode\ncomputes orientation transactions",
            fillcolor="#dcfce7"
        ];
        ZoomCameraMode [
            label="ZoomCameraMode\ncomputes distance transactions",
            fillcolor="#dcfce7"
        ];
        TrajectoryCameraMode [
            label="TrajectoryCameraMode\ncomputes target transactions",
            fillcolor="#dcfce7"
        ];
        NavigationCameraMode [
            label="NavigationCameraMode\ncomputes transactions",
            fillcolor="#dcfce7"
        ];
        CameraState [
            label="CameraState\ncanonical camera variables + revision\ncommit is mutation boundary",
            fillcolor="#dcfce7"
        ];
        CameraTransaction [
            label="CameraState.Transaction\natomic camera mutation",
            fillcolor="#dcfce7"
        ];
        SnapshotProvider [
            label="SnapshotProvider\nmode-independent camera snapshot producer",
            fillcolor="#ede9fe"
        ];
        CameraSnapshot [
            label="SnapshotProvider.CameraSnapshot\nimmutable render camera",
            fillcolor="#ede9fe"
        ];
        PreparedRenderSnapshotProvider [
            label="PreparedRenderSnapshotProviding\nscene snapshot source",
            fillcolor="#ede9fe"
        ];
    }

    subgraph cluster_renderer {
        label="Renderer Consumption";
        color="#fdba74";
        style="rounded";

        MetalRenderer [
            label="MetalRenderer\nticks controllers + composes render state",
            fillcolor="#ffedd5"
        ];
        DrawFirstPass [
            label="MetalRenderer+DrawFirstPass\nrender encoding",
            fillcolor="#ffedd5"
        ];
        SceneRenderState [
            label="SceneRenderState\ncamera + scene + routes",
            fillcolor="#ffedd5"
        ];
        SceneRouteRenderState [
            label="SceneRouteRenderState\ntransfer + navigation routes",
            fillcolor="#ffedd5"
        ];
        RouteRenderer [
            label="RouteRenderer\nuses navigation route render state",
            fillcolor="#ffedd5"
        ];
        TransferPreview [
            label="TransferOrbitRenderState\ncontroller-owned preview handoff",
            fillcolor="#ffedd5"
        ];
    }

    MetalModuleResources -> CameraState [
        label="creates",
        color="#2563eb"
    ];
    MetalModuleResources -> CameraCoordinator [
        label="creates with CameraState + SnapshotProvider",
        color="#2563eb"
    ];
    MetalModuleResources -> SnapshotProvider [
        label="creates with CameraState + scene source",
        color="#2563eb"
    ];
    MetalModuleResources -> NavigationController [
        label="creates internal owner",
        color="#2563eb"
    ];
    MetalModuleResources -> TransferOrbitController [
        label="creates internal owner",
        color="#2563eb"
    ];
    MetalModuleResources -> MetalRenderer [
        label="injects controllers + CameraCoordinator",
        color="#2563eb"
    ];
    MetalModuleResources -> CameraCoordinator [
        label="routes follow/manual commands",
        color="#16a34a",
        penwidth=2
    ];
    MetalModuleResources -> MetalModuleNavigationControlling [
        label="implements public facade",
        color="#d97706",
        penwidth=2
    ];
    MetalModuleResources -> NavigationStateCallbacks [
        label="subscribes",
        color="#d97706",
        penwidth=2
    ];
    MetalModuleResources -> MetalModuleTransferOrbitControlling [
        label="implements transfer preview facade",
        color="#d97706",
        penwidth=2
    ];
    NavigationStateCallbacks -> NavigationController [
        label="mirrors internal state",
        color="#d97706"
    ];

    NavigationController -> MetalModuleNavigationControlling [
        label="internal command implementation",
        color="#2563eb",
        style=dashed
    ];
    NavigationController -> NavigationRouteCoordinator [
        label="owns",
        color="#2563eb",
        penwidth=2
    ];
    NavigationController -> SnapshotProvider [
        label="reads latest scene snapshot",
        color="#7c3aed"
    ];
    NavigationController -> NavigationCameraCoordinating [
        label="depends on protocol",
        color="#16a34a",
        penwidth=2
    ];
    NavigationController -> NavigationRouteRenderState [
        label="exposes routeRenderState",
        color="#ea580c"
    ];
    NavigationControllerRoute -> NavigationRouteCoordinator [
        label="start/pause/resume/cancel/done",
        color="#2563eb"
    ];
    NavigationControllerCamera -> NavigationCameraCoordinating [
        label="claim/suspend/end + commit follow/arrival/transition",
        color="#16a34a",
        penwidth=2
    ];
    NavigationControllerProjection -> CameraProjectionParameters [
        label="returns generic route-adjusted near/far",
        color="#7c3aed",
        penwidth=2
    ];
    NavigationControllerProjection -> NavigationRouteCoordinator [
        label="reads active route",
        color="#2563eb"
    ];
    NavigationControllerProjection -> NavigationCameraCoordinating [
        label="reads camera target/distance",
        color="#16a34a"
    ];

    MetalModuleTransferOrbitControlling -> TransferOrbitController [
        label="delegates preview commands",
        color="#2563eb",
        style=dashed
    ];
    TransferOrbitController -> SnapshotProvider [
        label="reads latest scene snapshot",
        color="#7c3aed"
    ];
    TransferOrbitController -> TransferPreviewCameraCoordinating [
        label="commits preview camera transactions",
        color="#16a34a",
        penwidth=2
    ];
    TransferOrbitController -> CameraProjectionParameters [
        label="returns preview-adjusted far plane",
        color="#7c3aed",
        penwidth=2
    ];
    TransferOrbitController -> TransferPreview [
        label="publishes renderState",
        color="#ea580c",
        penwidth=2
    ];

    CameraCoordinator -> NavigationCameraCoordinating [
        label="implements forwarding API",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> NavigationCameraOwner [
        label="delegates nav camera ownership",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> TransferPreviewCameraCoordinating [
        label="implements forwarding API",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> CameraState [
        label="commits manual transactions\n+ refreshes derived values",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> OrbitCameraMode [
        label="routes pan / inertia",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> ZoomCameraMode [
        label="routes pinch / inertia",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> TrajectoryCameraMode [
        label="routes trajectory pan",
        color="#16a34a",
        penwidth=2
    ];
    OrbitCameraMode -> CameraTransaction [
        label="returns orientation transaction",
        color="#16a34a",
        penwidth=2
    ];
    ZoomCameraMode -> CameraTransaction [
        label="returns distance transaction",
        color="#16a34a",
        penwidth=2
    ];
    TrajectoryCameraMode -> CameraTransaction [
        label="returns target transaction",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> FollowCameraOwner [
        label="delegates follow lifecycle",
        color="#16a34a",
        penwidth=2
    ];
    FollowCameraOwner -> FollowCameraMode [
        label="owns mode math",
        color="#16a34a",
        penwidth=2
    ];
    FollowCameraMode -> CameraTransaction [
        label="returns transactions",
        color="#16a34a",
        penwidth=2
    ];
    FollowCameraOwner -> CameraState [
        label="commits follow transactions",
        color="#16a34a",
        penwidth=2
    ];
    FollowCameraOwner -> SnapshotProvider [
        label="reads latest scene snapshot",
        color="#7c3aed"
    ];
    NavigationCameraOwner -> NavigationCameraMode [
        label="owns mode math",
        color="#16a34a",
        penwidth=2
    ];
    NavigationCameraMode -> CameraTransaction [
        label="returns transactions",
        color="#16a34a",
        penwidth=2
    ];
    NavigationCameraOwner -> CameraState [
        label="commits transactions",
        color="#16a34a",
        penwidth=2
    ];
    CameraCoordinator -> TransferPreviewCameraOwner [
        label="delegates preview camera commits",
        color="#16a34a",
        penwidth=2
    ];
    CameraTransaction -> CameraState [
        label="target/position/offset/up/distance/orientation",
        color="#16a34a"
    ];
    TransferPreviewCameraOwner -> CameraTransaction [
        label="creates transaction",
        color="#16a34a",
        penwidth=2
    ];
    TransferPreviewCameraOwner -> CameraState [
        label="commits transactions",
        color="#16a34a",
        penwidth=2
    ];
    CameraState -> SnapshotProvider [
        label="canonical camera variables + revision",
        color="#7c3aed"
    ];
    PreparedRenderSnapshotProvider -> SnapshotProvider [
        label="latest scene snapshot",
        color="#7c3aed"
    ];
    CameraProjectionParameters -> SnapshotProvider [
        label="explicit mode-agnostic near/far",
        color="#7c3aed",
        penwidth=2
    ];
    SnapshotProvider -> CameraSnapshot [
        label="produces immutable render camera",
        color="#7c3aed",
        penwidth=2
    ];

    MetalRenderer -> NavigationController [
        label="ticks route navigation; reads controlsCamera",
        color="#ea580c"
    ];
    MetalRenderer -> TransferOrbitController [
        label="ticks preview; reads render/projection state",
        color="#ea580c"
    ];
    MetalRenderer -> CameraProjectionParameters [
        label="composes base + follow + preview + navigation projection",
        color="#7c3aed",
        penwidth=2
    ];
    MetalRenderer -> CameraCoordinator [
        label="ticks follow mode; reads follow projection policy",
        color="#16a34a",
        penwidth=2
    ];
    MetalRenderer -> SnapshotProvider [
        label="requests CameraSnapshot",
        color="#7c3aed",
        penwidth=2
    ];
    MetalRenderer -> SceneRenderState [
        label="assembles render state",
        color="#ea580c"
    ];
    SceneRenderState -> CameraSnapshot [
        label="contains",
        color="#ea580c"
    ];
    SceneRenderState -> SceneRouteRenderState [
        label="contains",
        color="#ea580c"
    ];
    SceneRouteRenderState -> NavigationRouteRenderState [
        label="contains",
        color="#ea580c"
    ];
    SceneRouteRenderState -> TransferPreview [
        label="contains",
        color="#ea580c"
    ];
    MetalRenderer -> DrawFirstPass [
        label="passes SceneRenderState",
        color="#ea580c"
    ];
    DrawFirstPass -> CameraSnapshot [
        label="uses matrices/origin/viewport",
        color="#ea580c",
        penwidth=2
    ];
    DrawFirstPass -> RouteRenderer [
        label="passes navigation route state",
        color="#ea580c"
    ];
}
