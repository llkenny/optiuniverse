#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Body", "Clouds", "Clouds_Material", "Clouds_Shader", "Clouds_External_Shader", "Earth_Material", "SpinAnimation", "Loop_SpinAnimation", "Clouds_External", "Clouds_External_Material"]
    def Material "Earth_Material"
    {
        token inputs:frame:stPrimvarName = "st" (
            customData = {
                dictionary realitykit = {
                    bool hide = 1
                }
            }
        )
        token outputs:mtlx:surface
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/Earth_Material/UsdPreviewSurface.outputs:surface>

        def Shader "UsdPreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            float inputs:clearcoat = 0
            float inputs:clearcoatRoughness = 0.01
            color3f inputs:diffuseColor = (0.18, 0.18, 0.18)
            color3f inputs:diffuseColor.connect = </Root/Earth_Material/diffuseColor.outputs:rgb>
            color3f inputs:emissiveColor = (0, 0, 0)
            float inputs:ior = 1.5
            float inputs:metallic = 0
            normal3f inputs:normal = (0, 0, 1)
            normal3f inputs:normal.connect = </Root/Earth_Material/normal.outputs:rgb>
            float inputs:occlusion = 1
            float inputs:roughness = 0.5
            token outputs:surface
        }

        def Shader "diffuseColor"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_daymap.jpg@
            float2 inputs:st.connect = </Root/Earth_Material/diffuseColor/TexCoordReader.outputs:result>
            color3f outputs:rgb

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "normal"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_normal_map.png@
            float2 inputs:st.connect = </Root/Earth_Material/normal/TexCoordReader.outputs:result>
            normal3f outputs:rgb

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "emissiveColor"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_nightmap.jpg@
            float2 inputs:st.connect = </Root/Earth_Material/emissiveColor/TexCoordReader.outputs:result>
            color3f outputs:rgb

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "roughness"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/roughness/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "occlusion"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/occlusion/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "ior"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/ior/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "clearcoatRoughness"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/clearcoatRoughness/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "clearcoat"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/clearcoat/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "metallic"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @8k_earth_specular_map.tif@
            float2 inputs:st.connect = </Root/Earth_Material/metallic/TexCoordReader.outputs:result>
            float outputs:r

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/Earth_Material.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }
    }

    def Sphere "Body" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Earth_Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
    }

    def RealityKitTimeline "SpinAnimation"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Spin"
            {
                string actionKind = "spin"
                int blendLayer = 400
                double duration = 1000
                uniform token info:id = "FCB6C28F-A8C4-4F4E-A6A2-6B16F682EC42"
                token spinDirection = "counterclockwise"
                double startTime = 0
                rel target = </Root/Clouds>

                def RealityKitStruct "timingFunction"
                {
                    token type = "linear"
                }
            }
        }
    }

    def RealityKitTimeline "Loop_SpinAnimation"
    {
        def RealityKitTrack "Track"
        {
            def RealityKitAction "Play_Timeline"
            {
                string actionKind = "timeline"
                int blendLayer = 500
                double duration = 1000
                uniform token info:id = "3C4B895D-21BF-4C36-B289-0668F213F5D5"
                double loopCount = 0
                double startTime = -0.0020079770561685054
                rel timeline = </Root/SpinAnimation>
            }
        }
    }

    def Sphere "Clouds_External" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (0, 0, 0)
        }
    )
    {
        rel material:binding = </Root/Clouds_External_Shader> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
        float2 ui:nodegraph:node:pos = (40, 40)
        int ui:nodegraph:node:stackingOrder = 2
        quatf xformOp:orient = (0.99999994, 0, 0, 0)
        float3 xformOp:scale = (1.015, 1.015, 1.015)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = </Root/Clouds_External/OnAddedToScene>
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/Clouds_External/OnAddedToScene/Action>
            uniform bool exclusive
            rel triggers = </Root/Clouds_External/OnAddedToScene/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/Clouds_External>
                token info:id = "SceneTransition"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/Loop_SpinAnimation>
                rel animationLibraryKeyOverrideKey = </Root/Clouds_External/OnAddedToScene/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }

    def Sphere "Clouds" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (0, 0, 0)
        }
    )
    {
        rel material:binding = </Root/Clouds_Shader> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1.01, 1.01, 1.01)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "RCP_BehaviorsContainer"
        {
            rel behaviors = </Root/Clouds/OnAddedToScene>
            uniform token info:id = "RCP.BehaviorsContainer"
        }

        def Preliminary_Behavior "OnAddedToScene"
        {
            rel actions = </Root/Clouds/OnAddedToScene/Action>
            uniform bool exclusive
            rel triggers = </Root/Clouds/OnAddedToScene/Trigger>

            def Preliminary_Trigger "Trigger"
            {
                rel affectedObjects = </Root/Clouds>
                token info:id = "SceneTransition"
            }

            def Preliminary_Action "Action"
            {
                rel affectedObjects = </Root>
                rel animationLibraryKey = </Root/Loop_SpinAnimation>
                rel animationLibraryKeyOverrideKey = </Root/Clouds/OnAddedToScene/Trigger>
                token info:id = "PlayTimeline"
                int loops = 0
                int performCount = 1
                token type = "serial"
            }
        }
    }

    def Material "Clouds_Shader"
    {
        token outputs:mtlx:surface.connect = </Root/Clouds_Shader/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (365.25, 130.5)

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            float inputs:clearcoat
            float inputs:clearcoatRoughness
            color3f inputs:diffuseColor.connect = </Root/Clouds_Shader/Image.outputs:out>
            color3f inputs:emissiveColor.connect = </Root/Clouds_Shader/Image.outputs:out>
            float inputs:ior
            float inputs:metallic = 0
            float3 inputs:normal
            float inputs:occlusion
            float inputs:opacity = 0.6
            float inputs:opacityThreshold
            float inputs:roughness = 1
            token outputs:out
            float2 ui:nodegraph:node:pos = (136.98828, 159.16016)
            int ui:nodegraph:node:stackingOrder = 22
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
        }

        def Shader "Image"
        {
            uniform token info:id = "ND_image_color3"
            asset inputs:file = @8k_earth_clouds.jpg@
            string inputs:filtertype
            string inputs:vaddressmode
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (-158.1875, 178.22656)
            int ui:nodegraph:node:stackingOrder = 23
        }
    }

    def Material "Clouds_External_Shader"
    {
        token outputs:mtlx:surface.connect = </Root/Clouds_External_Shader/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:node:pos = (245.75, 199.25)
        int ui:nodegraph:node:stackingOrder = 1
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (365.25, 130.5)

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            float inputs:clearcoat
            float inputs:clearcoatRoughness
            color3f inputs:diffuseColor = (0.92941177, 0.92941177, 0.95686275) (
                colorSpace = "lin_srgb"
            )
            color3f inputs:emissiveColor.connect = None
            float inputs:ior
            float inputs:metallic = 0
            float3 inputs:normal
            float inputs:occlusion
            float inputs:opacity = 0.6
            float inputs:opacity.connect = </Root/Clouds_External_Shader/Image.outputs:out>
            float inputs:opacityThreshold
            float inputs:roughness = 1
            token outputs:out
            float2 ui:nodegraph:node:pos = (136.98828, 159.16016)
            int ui:nodegraph:node:stackingOrder = 24
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["Advanced"]
        }

        def Shader "Image"
        {
            uniform token info:id = "ND_image_float"
            asset inputs:file = @Nuvem_baseColor.png@
            string inputs:filtertype
            string inputs:vaddressmode
            float outputs:out
            float2 ui:nodegraph:node:pos = (-158.1875, 178.22656)
            int ui:nodegraph:node:stackingOrder = 23
        }
    }
}

